{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".github/workflows/ci.yml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:e2e": {}
  }
}
