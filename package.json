{
  "name": "meet-poll",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:be": "turbo run dev --filter=backend",
    "dev:fe": "turbo run dev --filter=frontend",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "bun@1.4.2"
}
