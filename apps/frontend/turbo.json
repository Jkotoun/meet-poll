{
  "extends": ["//"],
  "tasks": {
    "api:generate": {
      "inputs": ["$TURBO_ROOT$/apps/backend/openapi.json"],
      "outputs": ["src/api/schema.d.ts"]
    },
    "dev": {
      "dependsOn": ["api:generate"]
    },
    "build": {
      "dependsOn": ["^build", "api:generate"],
      // The standalone bundle (with its own node_modules copy) is only used by
      // the Docker build, which doesn't go through Turbo's cache.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "!.next/standalone/**"
      ]
    },
    // Both read the route types in .next/types; `next build` wipes .next/ on
    // start, so they must not run in parallel with it.
    "lint": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["api:generate"]
    }
  }
}
