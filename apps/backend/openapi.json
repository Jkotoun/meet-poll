{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": ["health"]
      }
    }
  },
  "info": {
    "title": "Meet Poll API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "string",
        "enum": ["ok"]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ]
          }
        },
        "required": ["status"]
      },
      "InvalidFieldDto": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "example": "#/title"
          },
          "detail": {
            "type": "string",
            "example": "title should not be empty"
          }
        },
        "required": ["pointer", "detail"]
      },
      "ProblemBaseDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Request validation failed"
          },
          "instance": {
            "type": "string",
            "example": "/v1/events"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvalidFieldDto"
            }
          }
        },
        "required": ["title", "status", "instance"]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Request validation failed"
          },
          "instance": {
            "type": "string",
            "example": "/v1/events"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvalidFieldDto"
            }
          },
          "type": {
            "type": "string",
            "enum": ["about:blank"]
          }
        },
        "required": ["title", "status", "instance", "type"]
      }
    }
  }
}
