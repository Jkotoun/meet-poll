  },
  "info": {
    "title": "Meet Poll API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Ada Lovelace"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": ["email", "name", "password"]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "email", "name"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "CreateTimeSlotDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-02T09:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-02T10:00:00Z"
          }
        },
        "required": ["startsAt", "endsAt"]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Team lunch"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone",
            "example": "Europe/Prague"
          },
          "slots": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateTimeSlotDto"
            }
          }
        },
        "required": ["title", "timezone", "slots"]
      },
      "OrganizerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "TimeSlotDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "startsAt", "endsAt"]
      },
      "EventDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "q3Vx_7bA0kLm"
          },
          "title": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Prague"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "organizer": {
            "$ref": "#/components/schemas/OrganizerDto"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSlotDto"
            }
          }
        },
        "required": [
          "slug",
          "title",
          "timezone",
          "createdAt",
          "organizer",
          "slots"
        ]
      },
      "EventSummaryDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "q3Vx_7bA0kLm"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["slug", "title", "createdAt"]
      },
      "HealthStatus": {
        "type": "string",
        "enum": ["ok"]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ]
          }
        },
        "required": ["status"]
      },
      "InvalidFieldDto": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "example": "#/title"
          },
          "detail": {
            "type": "string",
            "example": "title should not be empty"
          }
        },
        "required": ["pointer", "detail"]
      },
      "ProblemBaseDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Request validation failed"
          },
          "instance": {
            "type": "string",
            "example": "/v1/events"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvalidFieldDto"
            }
          }
        },
        "required": ["title", "status", "instance"]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Request validation failed"
          },
          "instance": {
            "type": "string",
            "example": "/v1/events"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvalidFieldDto"
            }
          },
          "type": {
            "type": "string",
            "enum": ["about:blank"]
          }
        },
        "required": ["title", "status", "instance", "type"]
      }
    }
  }
}
