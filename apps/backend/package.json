  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "oxfmt src test",
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "bun test src",
    "test:watch": "bun --watch test src",
    "test:cov": "bun test src --coverage",
    "test:debug": "bun --inspect-brk test src",
    "test:e2e": "bun test test"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
